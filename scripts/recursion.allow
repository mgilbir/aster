# Every recursive cycle in the engine, with how its depth is bounded (see
# internal/cmd/recursionaudit and TestDeepInput). A stack overflow is fatal in
# Go: an entry must name the limit, not a recovery.
#
# cycle<TAB># how it is bounded

(*internal/expr.Node).Walk	# walks an expr.Node tree; Nodes come only from the expression parser, which counts depth in parser.node and fails past expr.MaxDepth = 512 (internal/expr/parse.go: parser.node), left-associative chains included
(*internal/expr.Scope).looseEquals	# fixed depth: each recursive step turns a boolean into a number or an object into a string (Scope.primitive), neither of which is object-like again, so it recurses at most 3 times whatever the value (internal/expr/js.go: looseEquals)
(*internal/expr.Scope).strDepth	# String() of an array nested at run time (formulas and signals can wrap a value once each): depth parameter, throws RangeError past jsval.MaxValueDepth = 1024 (internal/expr/js.go: Scope.strDepth); frames under 200 bytes; shapes data-wrapped-arrays, signal-wrapped-arrays; test internal/expr/depth_test.go
(*internal/expr.compiler).array (*internal/expr.compiler).binary (*internal/expr.compiler).call (*internal/expr.compiler).compile (*internal/expr.compiler).concatChain (*internal/expr.compiler).conditional (*internal/expr.compiler).logical (*internal/expr.compiler).member (*internal/expr.compiler).object (*internal/expr.compiler).unary	# compiles an expr.Node tree, one frame set per level; the tree is at most expr.MaxDepth = 512 deep (enforced by parser.node in internal/expr/parse.go before compile runs); shapes expr-parens, expr-calls, expr-array-literal, expr-object-literal, expr-member-chain, expr-binary-chain (a chain of + is compiled by concatChain, which walks the left spine in a loop and recurses only into the operands)
(*internal/expr.parser).parseArguments (*internal/expr.parser).parseArray (*internal/expr.parser).parseBinary (*internal/expr.parser).parseConditional (*internal/expr.parser).parseExpression (*internal/expr.parser).parseGroup (*internal/expr.parser).parseLeftHandSide (*internal/expr.parser).parseObject (*internal/expr.parser).parseObjectProperty (*internal/expr.parser).parsePostfix (*internal/expr.parser).parsePrimary (*internal/expr.parser).parseUnary	# recursive descent over expression text: every cycle passes parseUnary or parseConditional, which count p.depth and fail past expr.MaxDepth = 512 (internal/expr/parse.go: parseUnary, parseConditional); about 12 frames of under 200 bytes per level, under 2 MB in all; shapes expr-parens, expr-calls, expr-array-literal, expr-object-literal, expr-unary-minus, expr-unary-not, expr-ternary-chain
(*internal/format.TimeLocale).compileFormat	# %c, %x and %X expand into the locale's own formats: depth parameter bounded by maxLocaleNesting = 8 and the number of expansions by maxLocaleExpansions = 4096 (internal/format/timelocale.go, checked in timeformat.go: compileFormat); the locale can come from the spec (config.locale), so the work bound matters as much as the depth; test internal/format/depth_test.go
(*internal/format.TimeLocale).compileParse	# same as compileFormat: maxLocaleNesting = 8 and maxLocaleExpansions = 4096, checked in internal/format/timeparse.go: compileParse (past either the specifier is reported bad)
(*internal/geo.resampler).lineTo	# subdivision depth counts down from resampleMaxDepth = 16 (internal/geo/resample.go: lineTo, 'depth > 0' test before 'depth--')
(*internal/jsval.parser).array (*internal/jsval.parser).object (*internal/jsval.parser).value	# JSON parser: depth parameter, fails past jsval.MaxJSONDepth = 256 (internal/jsval/json.go: parser.value, array and object each test it before descending); shapes spec-json-objects, spec-json-arrays, data-nested-arrays, data-nested-objects
(*internal/raster.cssApplier).visit	# walks the parsed SVG DOM, whose depth the SVG parser limits to Limits.MaxDepth = 256 (defaultMaxDepth, internal/raster/dom.go: parse, 'len(stack)+1 > lim.MaxDepth'); not configurable through the public API; styles are applied after parsing
(*internal/raster.renderer).addElemBBox (*internal/raster.renderer).childrenBBox (*internal/raster.renderer).contentBBox (*internal/raster.renderer).viewportBBox	# bounding-box walk: renderer.nest counts nested elements in addElemBBox and stops past Limits.MaxDepth*2 = 512 (internal/raster/bbox.go: addElemBBox); every cycle of this component passes addElemBBox (checked with recursionaudit -list -cut addElemBBox)
(*internal/raster.renderer).applyMask (*internal/raster.renderer).drawContent (*internal/raster.renderer).drawDecorations (*internal/raster.renderer).drawGlyphs (*internal/raster.renderer).drawGlyphs$lit3 (*internal/raster.renderer).drawGlyphs$lit4 (*internal/raster.renderer).drawMarker (*internal/raster.renderer).drawMarker$lit1 (*internal/raster.renderer).drawMarkers (*internal/raster.renderer).drawPath (*internal/raster.renderer).drawPath$lit2 (*internal/raster.renderer).drawPath$lit3 (*internal/raster.renderer).patternPaint (*internal/raster.renderer).patternPaint$lit2 (*internal/raster.renderer).patternPaint$lit3 (*internal/raster.renderer).renderChildren (*internal/raster.renderer).renderEffects (*internal/raster.renderer).renderElement (*internal/raster.renderer).renderNestedSVG (*internal/raster.renderer).renderShape (*internal/raster.renderer).renderText (*internal/raster.renderer).renderUse (*internal/raster.renderer).renderViewport (*internal/raster.renderer).resolvePaint (*internal/raster.renderer).serverPaint	# the large rendering component (elements, <use>, patterns, markers, masks, filters, text, paint servers): every cycle passes renderElement, which counts r.nest and fails past Limits.MaxDepth*2 = 512 (internal/raster/render.go: renderElement), checked with recursionaudit -list -cut renderElement (the residue is the entries below); offscreen layers are further limited by Limits.MaxLayerDepth = 16 (render.go, effects.go, pattern.go: subRender); a few KB of frames per level, a few MB at 512; shapes svg-nested-groups-png, svg-nested-svg-png, svg-use-chain-png, svg-pattern-chain-png, svg-mask-chain-png, svg-marker-chain-png, svg-nested-anchors-png
(*internal/raster.renderer).buildClip	# clip-path on a clipPath: depth parameter, the clip is refused past maxClipDepth = 8 (internal/raster/render.go: buildClip); shape svg-nested-clips-png
(*internal/raster.renderer).buildClip$lit1	# the clipPath shape collector follows <use> elements: a chain or cycle of <use> inside a clipPath recursed without bound; now a hops counter stops past Limits.MaxDepth = 256 (internal/raster/render.go: buildClip, collect); shape svg-clip-use-cycle-png (crashed the process before)
(*internal/raster.renderer).inheritedState	# walks up the parent chain of a DOM node; the DOM is at most Limits.MaxDepth = 256 deep (internal/raster/dom.go: parse), so at most 256 frames
(*internal/raster.renderer).resolveMask	# a mask referencing a mask: depth parameter, refused past depth 4 (internal/raster/effects.go: resolveMask); applyMask recurses along that same chain, so at most 5 levels; shape svg-mask-chain-png
(*internal/raster.selector).matchAt	# one frame per compound selector of a CSS rule; selectors are refused past maxCompounds = 32 and maxSelectorBytes = 4096 (internal/raster/css.go: parseSelector), and matching spends a work budget (Limits.MaxCSSWork); shapes svg-css-sibling-selector-png, svg-css-descendant-selector-png
(*internal/raster.textCollector).walk	# walks <text>/<tspan> nesting inside the parsed SVG DOM, at most Limits.MaxDepth = 256 deep (internal/raster/dom.go: parse); shape svg-nested-tspans-png
(*internal/scene.Bounder).boundTree	# depth parameter, returns ErrTooDeep past scene.MaxDepth = 256 (internal/scene/bound.go: boundTree); the scenegraph is also at most 64 group scopes deep (vega maxContextDepth)
(*internal/scene.jsonLoader).item (*internal/scene.jsonLoader).mark	# scenegraph JSON loader (scene.FromJSON, not reachable from the public API): depth parameter, ErrTooDeep past scene.MaxDepth = 256 (internal/scene/json.go: jsonLoader.mark); the document is also limited by jsval.MaxJSONDepth = 256
(*internal/svg.renderer).group (*internal/svg.renderer).item (*internal/svg.renderer).mark	# SVG writer over the scenegraph: depth parameter, scene.ErrTooDeep past scene.MaxDepth = 256 (internal/svg/render.go: renderer.mark); the scenegraph itself is at most 64 group scopes deep; shapes nested-groups, nested-facets
(*internal/svgdiff.comparer).node	# SVG comparator used by tests and the oracle, not by the public API: its parser refuses elements nested past maxDepth = 512 (internal/svgdiff/svgdiff.go: parse), so the comparison recurses at most 512 levels (it was unbounded)
(*internal/svgpdf.renderer).children (*internal/svgpdf.renderer).element	# walks the parsed SVG element tree, whose nesting parseSVG limits to maxNestingDepth = 512 (internal/svgpdf/parse.go: parseSVG); shapes svg-nested-groups-pdf, svg-nested-tspans-pdf
(*internal/text.Measurer).MeasureText (*internal/text.Measurer).measureLines (*internal/text.Measurer).measureTabs	# depth at most 3, whatever the input: measureLines measures lines with no line separator, measureTabs pieces with no tab, so the inner MeasureText takes the plain path
(*internal/transforms/wordcloud.inkRaster).cubicAt	# Bezier flattening: depth parameter, stops at maxDepth = 16 (internal/transforms/wordcloud/ink.go: cubicAt)
(*internal/vega.encCompiler).color (*internal/vega.encCompiler).entry (*internal/vega.encCompiler).property (*internal/vega.encCompiler).scaleTerm	# compiles encode entries, descending into the child objects of the spec value ({color:{r:{...}}}, {scale:.., band:{...}}, offset, mult, ...): one JSON level per call; the spec is parsed by jsval.ParseJSON, which refuses documents nested past jsval.MaxJSONDepth = 256 (internal/jsval/json.go: parser.value/array/object), and this recursion descends one JSON level of the spec (or of a value derived from it) per call; frames are a few hundred bytes, so 256 levels cost well under 1 MB
(*internal/vega.encCompiler).fieldObj (*internal/vega.encCompiler).fieldPath	# compiles nested field references ({field:{group:{field:...}}}), one JSON level per call: the spec is parsed by jsval.ParseJSON, which refuses documents nested past jsval.MaxJSONDepth = 256 (internal/jsval/json.go: parser.value/array/object), and this recursion descends one JSON level of the spec (or of a value derived from it) per call
(*internal/vega.labelPainter).draw	# depth parameter, stops past maxLabelGroupDepth = 64 (internal/vega/ops_label.go: labelPainter.draw)
(*internal/vega.opParams).flatten	# flattens a []any that rtContext.parseParameter built from the []P tree of the compiled spec: one level per nested array of the spec; the spec is parsed by jsval.ParseJSON, which refuses documents nested past jsval.MaxJSONDepth = 256 (internal/jsval/json.go: parser.value/array/object), and this recursion descends one JSON level of the spec (or of a value derived from it) per call
(*internal/vega.rtContext).makeSubflow (*internal/vega.rtContext).makeSubflow$lit1 (*internal/vega.rtContext).parse (*internal/vega.rtContext).parseOperatorParameters (*internal/vega.rtContext).parseParameter (*internal/vega.rtContext).parseParameters	# instantiates facet subflows at run time and parses parameter trees: group nesting is limited to maxContextDepth = 64 (internal/vega/context.go: rtContext.fork, 'group nesting too deep', called by every subflow instantiation) and parameter trees nest as the spec does (the spec is parsed by jsval.ParseJSON, which refuses documents nested past jsval.MaxJSONDepth = 256 (internal/jsval/json.go: parser.value/array/object), and this recursion descends one JSON level of the spec (or of a value derived from it) per call); the call-graph edge through makeSubflow's closure is only its definition, the closure runs later on a fresh fork; shapes nested-facets, nested-groups
(*internal/vega.runView).itemAsValue (*internal/vega.runView).markAsValue	# walks up item -> mark -> group item -> ...: the group nesting of the scenegraph, at most maxContextDepth = 64 (internal/vega/context.go: rtContext.fork; internal/vega/parse_view.go: parseScopeSpec)
(*internal/vegalite.coreNormalizer).mapLayerRepeat (*internal/vegalite.coreNormalizer).mapRepeat	# fixed depth: mapLayerRepeat calls mapRepeat once with a spec whose repeat has only row/column, which goes to mapNonLayerRepeat; nesting of repeats is counted by normParams.deeper (maxDepth = 64, internal/vegalite/normalize.go); shapes vl-nested-repeat, vl-nested-layer-repeat
(*internal/vegalite.coreNormalizer).mapUnit (*internal/vegalite.coreNormalizer).mapUnitWithParentEncodingOrProjection	# fixed depth: mapUnitWithParentEncodingOrProjection calls mapUnit with a fresh normParams that has no parent encoding or projection, so the second mapUnit takes the other branch: depth 2 (internal/vegalite/normalize.go)
(*internal/vegalite.eventParser).parseBetween (*internal/vegalite.eventParser).parseOne	# event selector text '[[a, b] > c, d] > e', a string of any length: eventParser.depth counts nested between selectors and parseBetween throws past maxEventNesting = 64 (internal/vegalite/eventselector.go: parseBetween; it was unbounded); shape vl-select-on-brackets
(*internal/vegalite.exprNode).visit	# visits the tree built by exprParser; exprParser.mk records each node's depth and fails past maxExprNodeDepth = 512 (internal/vegalite/exprdeps.go: exprParser.mk), left-associative chains (a+b+c, a.b.c, f()()) included, which were not counted before; shapes vl-calc-binary-chain, vl-calc-member-chain, vl-calc-call-chain, vl-filter-expression-chain
(*internal/vegalite.exprParser).parseBinary (*internal/vegalite.exprParser).parseConditional (*internal/vegalite.exprParser).parsePostfix (*internal/vegalite.exprParser).parsePrimary (*internal/vegalite.exprParser).parseUnary	# recursive descent over expression text: parseConditional and parseUnary count p.depth and fail past maxExprDepth = 200 (internal/vegalite/exprdeps.go); every cycle passes one of them
(*internal/vegalite.modelBase).assembleProjections internal/vegalite.assembleProjections	# walks the model tree (layer/concat/facet/repeat nesting), at most maxDepth = 64 deep: buildModel and newLayerModel fail past it (internal/vegalite/layer.go), after normalize's own counter (normParams.deeper, internal/vegalite/normalize.go); shapes vl-nested-layers, vl-nested-hconcat, vl-nested-vconcat, vl-nested-concat, vl-nested-facets, vl-nested-repeat
(*internal/vegalite.modelBase).getScaleComponent	# walks up the parent chain of a model, at most maxDepth = 64 levels (buildModel, newLayerModel in internal/vegalite/layer.go)
(*internal/vegalite.modelBase).trySelectionComponent	# walks up the parent chain of a model, at most maxDepth = 64 levels (buildModel, newLayerModel in internal/vegalite/layer.go)
