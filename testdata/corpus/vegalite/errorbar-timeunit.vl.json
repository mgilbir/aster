{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "An error bar summarised per bucket, the bucketing being a transform the summary comes after.",
  "data": {"url": "data/cars.json"},
  "mark": {"type": "errorbar", "extent": "ci", "ticks": true},
  "encoding": {
    "y": {
      "field": "Miles_per_Gallon",
      "type": "quantitative",
      "scale": {"zero": false},
      "title": "Miles per Gallon (95% CIs)"
    },
    "x": {"timeUnit": "year", "field": "Year"}
  }
}
