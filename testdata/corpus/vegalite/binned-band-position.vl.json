{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A bar and a tick over a column that arrived already bucketed, both centred on the bucket's start — which is a bucket like any other, drawn between two interpolated edges.",
  "config": {"bar": {"timeUnitBandPosition": 0}, "tick": {"timeUnitBandPosition": 0}},
  "data": {
    "values": [
      {"date": "2020-01-01T00:00:00Z", "v": 10},
      {"date": "2021-01-01T00:00:00Z", "v": 20},
      {"date": "2022-01-01T00:00:00Z", "v": 15}
    ]
  },
  "encoding": {
    "x": {"timeUnit": "binnedutcyear", "field": "date", "type": "temporal"},
