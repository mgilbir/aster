{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "A proportion labelled as one, a count axis stepping by whole numbers, and a theme's own mark colour.",
  "data": {
    "values": [
      {"era": "before", "band": "low", "amount": 28},
      {"era": "before", "band": "high", "amount": 55},
      {"era": "after", "band": "low", "amount": 43},
      {"era": "after", "band": "high", "amount": 12}
    ]
  },
  "config": {"mark": {"color": "purple", "filled": true}, "scale": {"zero": false}},
  "hconcat": [
    {
      "width": 120,
      "height": 100,
      "mark": "bar",
      "encoding": {
        "x": {"field": "era", "type": "nominal"},
        "y": {"aggregate": "sum", "field": "amount", "stack": "normalize"},
        "color": {"field": "band", "type": "nominal"}
      }
    },
    {
      "width": 120,
      "height": 100,
      "mark": "bar",
      "encoding": {
        "x": {"field": "era", "type": "nominal"},
        "y": {"aggregate": "count", "axis": {"format": "d"}}
      }
    }
  ]
}
