{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A concatenation whose plots filter a column the shared transforms had to write first.",
  "data": {
    "url": "data/cars.json"
  },
  "transform": [
    {
      "filter": "datum.Year != null"
    },
    {
      "calculate": "datum.Cylinders > 4 ? 'many' : 'few'",
      "as": "bank"
    }
  ],
  "hconcat": [
    {
      "transform": [
        {
          "filter": {
            "field": "bank",
            "equal": "few"
          }
        }
      ],
      "title": "Few",
      "mark": "point",
      "encoding": {
        "x": {
          "field": "Horsepower",
          "type": "quantitative"
        },
        "y": {
          "field": "Miles_per_Gallon",
          "type": "quantitative"
        }
      }
    },
    {
      "width": 20,
      "mark": "text",
      "encoding": {
        "y": {
          "field": "Origin",
          "type": "ordinal",
          "axis": null
        },
        "text": {
          "field": "Origin",
          "type": "nominal"
        }
      },
      "view": {
        "stroke": null
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "bank",
            "equal": "many"
          }
        }
      ],
      "title": "Many",
      "mark": "point",
      "encoding": {
        "x": {
          "field": "Horsepower",
          "type": "quantitative"
        },
        "y": {
          "field": "Miles_per_Gallon",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "concat": {
      "spacing": 10
    }
  }
}