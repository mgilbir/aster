{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bins on a reversed axis, whose spacing has to be pulled the other way with it.",
  "data": {"url": "data/movies.json"},
  "mark": {"type": "bar", "binSpacing": 2},
  "encoding": {
    "x": {"bin": {"maxbins": 10}, "field": "IMDB Rating", "scale": {"reverse": true}},
    "y": {"aggregate": "count"}
  }
}
