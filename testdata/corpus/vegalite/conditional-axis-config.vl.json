{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A theme that dashes every gridline but the one on a January, written as a predicate over a bucketed instant.",
  "data": {"url": "data/stocks.csv"},
  "transform": [{"filter": "datum.symbol==='GOOG'"}],
  "mark": "line",
  "encoding": {
    "x": {"field": "date", "type": "temporal"},
    "y": {"field": "price", "type": "quantitative"}
  },
  "config": {
    "axisX": {
      "gridDash": {
        "condition": {"test": {"field": "value", "timeUnit": "month", "equal": 1}, "value": []},
        "value": [2, 2]
      },
      "labelExpr": "timeFormat(datum.value, '%Y')"
    }
  }
}
