{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Two layers in one cell of a split facet: they share the one partition, and each hangs a chain of its own below it and a copy beside it.",
  "data": {"url": "data/barley.json"},
  "facet": {"row": {"field": "site", "type": "ordinal", "sort": {"op": "median", "field": "yield"}}},
  "spec": {
    "height": {"step": 12},
    "encoding": {
      "x": {"aggregate": "median", "field": "yield", "type": "quantitative", "scale": {"zero": false}}
    },
    "layer": [
      {
        "mark": "point",
        "encoding": {
          "y": {"field": "variety", "type": "ordinal", "sort": "-x"},
          "color": {"field": "year", "type": "nominal"}
        }
      },
      {"mark": "rule"}
    ]
  }
}
