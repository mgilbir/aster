{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Titles on a nested concatenation, and a ramp measured against the cell it stands beside.",
  "data": {
    "url": "data/cars.json"
  },
  "hconcat": [
    {
      "title": "By power",
      "vconcat": [
        {
          "width": 100,
          "height": 100,
          "mark": "point",
          "encoding": {
            "x": {
              "field": "Horsepower",
              "type": "quantitative"
            },
            "y": {
              "field": "Miles_per_Gallon",
              "type": "quantitative"
            },
            "color": {
              "field": "Acceleration",
              "type": "quantitative"
            }
          }
        },
        {
          "width": 100,
          "height": 140,
          "mark": "point",
          "encoding": {
            "x": {
              "field": "Weight_in_lbs",
              "type": "quantitative"
            },
            "y": {
              "field": "Miles_per_Gallon",
              "type": "quantitative"
            },
            "color": {
              "field": "Acceleration",
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ]
}
