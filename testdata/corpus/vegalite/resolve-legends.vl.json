        "color": {"field": "category", "type": "nominal"}
      }
    },
    {
      "width": 110,
      "height": 90,
      "mark": "point",
      "encoding": {
        "x": {"field": "score", "type": "quantitative"},
        "y": {"field": "amount", "type": "quantitative"},
        "color": {"field": "band", "type": "nominal"}
      }
    }
