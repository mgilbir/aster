    "values": [
      {"category": "Alpha", "amount": 28, "score": 3, "band": "low"},
      {"category": "Beta", "amount": 55, "score": 7, "band": "high"},
      {"category": "Gamma", "amount": 43, "score": 5, "band": "low"}
    ]
  },
  "resolve": {"scale": {"color": "independent"}},
  "hconcat": [
    {
      "width": 110,
      "height": 90,
      "mark": "bar",
      "encoding": {
        "x": {"field": "category", "type": "nominal"},
