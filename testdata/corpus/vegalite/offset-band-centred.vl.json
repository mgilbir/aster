{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Bars grouped inside a month centred on its own instant, not laid after it.",
  "data": {"url": "data/stocks.csv"},
  "transform": [
    {
      "filter": {
        "timeUnit": "binnedyearmonth",
        "field": "date",
        "range": [{"year": 2005, "month": 1}, {"year": 2005, "month": 3}]
      }
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {"timeUnit": "binnedyearmonth", "field": "date", "type": "temporal", "bandPosition": 0},
    "xOffset": {"field": "symbol", "type": "nominal"},
    "color": {"field": "symbol", "type": "nominal"},
    "y": {"field": "price", "type": "quantitative"}
  }
}
