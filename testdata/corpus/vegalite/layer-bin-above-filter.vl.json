{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Two layers binning one field: the bin is hoisted above each layer's own transforms and shared.",
  "data": {
    "url": "data/flights-20k.json"
  },
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "distance",
          "bin": true
        },
        "y": {
          "aggregate": "count"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.delay < 5"
        }
      ],
      "mark": "bar",
      "encoding": {
        "x": {
          "field": "distance",
          "bin": true
        },
        "y": {
          "aggregate": "count"
        },
        "color": {
          "value": "goldenrod"
        }
      }
    }
  ]
}
