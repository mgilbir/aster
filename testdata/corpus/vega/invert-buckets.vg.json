{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "invert() on scales that have buckets rather than a gradient: upstream answers the stretch of domain a range value covers, which is how a clicked legend swatch becomes a data range. A threshold scale's outermost buckets are unbounded and answer null at that end.",
  "width": 300,
  "height": 130,
  "padding": 5,

  "data": [
    {
      "name": "rows",
      "values": [
        {"label": "quantize red"},
        {"label": "quantize blue"},
        {"label": "quantile b"},
        {"label": "threshold low"},
        {"label": "threshold high"},
        {"label": "not in range"}
      ]
    }
  ],

  "scales": [
    {
      "name": "q",
      "type": "quantize",
      "domain": [0, 100],
      "range": ["red", "green", "blue"]
    },
    {
      "name": "qt",
      "type": "quantile",
      "domain": [3, 6, 7, 8, 8, 10, 13, 15, 16, 20],
      "range": ["a", "b", "c", "d"]
    },
    {
      "name": "th",
      "type": "threshold",
      "domain": [10, 20],
      "range": ["low", "mid", "high"]
    },
    {
      "name": "yscale",
      "type": "band",
      "domain": {"data": "rows", "field": "label"},
      "range": "height",
      "padding": 0.1
    }
  ],

  "signals": [
    {"name": "qRed", "update": "invert('q', 'red')"},
    {"name": "qBlue", "update": "invert('q', 'blue')"},
    {"name": "qtB", "update": "invert('qt', 'b')"},
    {"name": "thLow", "update": "invert('th', 'low')"},
    {"name": "thHigh", "update": "invert('th', 'high')"},
    {"name": "absent", "update": "invert('q', 'magenta')"}
  ],

  "axes": [{"orient": "left", "scale": "yscale"}],

  "marks": [
    {
      "type": "text",
      "from": {"data": "rows"},
      "encode": {
        "enter": {
          "x": {"value": 0},
          "y": {"scale": "yscale", "field": "label", "band": 0.5},
          "baseline": {"value": "middle"},
          "text": {
            "signal": "datum.label === 'quantize red' ? '' + qRed : datum.label === 'quantize blue' ? '' + qBlue : datum.label === 'quantile b' ? '' + qtB : datum.label === 'threshold low' ? '' + thLow : datum.label === 'threshold high' ? '' + thHigh : '' + absent"
          }
        }
      }
    }
  ]
}
