{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Static per-item `zindex` on overlapping marks. The audit asked (Q4) how reachable this is from a compiled scene and whether it is on-screen wrongness or SVG-only machinery: it is a plain encode channel, it reorders painting, and the marks here overlap so the order is what the picture is. A text mark sunk under the rects and a rule raised over them cover the negative and the cross-marktype cases.",
  "width": 140,
  "height": 60,
  "padding": 0,
  "data": [
    {
      "name": "t",
      "values": [
        {"i": 0, "z": 0, "c": "#4c78a8"},
        {"i": 1, "z": 5, "c": "#e45756"},
        {"i": 2, "z": 0, "c": "#54a24b"}
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "stack",
      "from": {"data": "t"},
      "encode": {
        "update": {
          "x": {"signal": "datum.i * 30"},
          "width": {"value": 70},
          "y": {"value": 10},
          "height": {"value": 40},
          "fill": {"field": "c"},
          "zindex": {"field": "z"}
        }
      }
    },
    {
      "type": "text",
      "name": "sunk",
      "encode": {
        "update": {
          "x": {"value": 70},
          "y": {"value": 34},
          "align": {"value": "center"},
          "text": {"value": "under"},
          "fontSize": {"value": 14},
          "fill": {"value": "#000"},
          "zindex": {"value": -1}
        }
      }
    },
    {
      "type": "rule",
      "name": "raised",
      "encode": {
        "update": {
          "x": {"value": 0},
          "x2": {"value": 140},
          "y": {"value": 30},
          "y2": {"value": 30},
          "stroke": {"value": "#000"},
          "strokeWidth": {"value": 2},
          "zindex": {"value": 9}
        }
      }
    }
  ]
}
