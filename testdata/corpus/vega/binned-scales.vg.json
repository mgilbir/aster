      "range": ["#f2f0f7", "#cbc9e2", "#9e9ac8", "#6a51a3"]
    },
    {
      "name": "byLimitNiced",
      "type": "threshold",
      "domain": [8, 57],
      "nice": true,
      "range": ["#edf8e9", "#74c476", "#006d2c"]
    },
    {
      "name": "byWidthRaw",
      "type": "quantize",
      "domain": [8, 95],
      "range": [0, 80, 160, 240]
    },
    {
      "name": "byWidthNiced",
      "type": "quantize",
      "domain": [8, 95],
      "nice": true,
      "range": [0, 80, 160, 240]
    }
  ],
  "axes": [
