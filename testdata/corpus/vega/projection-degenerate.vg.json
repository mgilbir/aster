          "fill": {
            "value": "#cfd8dc"
          },
          "stroke": {
            "value": "#37474f"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "shape",
      "from": {
        "data": "world"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "uncapped"
        }
      ],
      "encode": {
        "enter": {
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#7a4fb5"
          },
          "strokeWidth": {
            "value": 0.7
          }
        }
      }
    }
  ]
