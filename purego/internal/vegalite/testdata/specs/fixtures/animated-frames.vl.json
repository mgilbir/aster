{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A chart advanced by a clock: the frame is a table of its own, and the scales still measure the whole column.",
  "data": {"url": "data/cars.json"},
  "mark": "point",
  "params": [
    {"name": "animation_frame", "select": {"type": "point", "fields": ["Year"], "on": "timer"}}
  ],
  "transform": [{"filter": {"param": "animation_frame"}}],
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "color": {"field": "Origin", "type": "nominal"},
    "time": {"field": "Year", "type": "ordinal"}
  }
}
