{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A heatmap of counts labelled in black or white, whose two layers ask for colour scales of different kinds — so the channel resolves independently rather than merging into a scale that is neither.",
  "data": {"url": "data/cars.json"},
  "transform": [
    {"aggregate": [{"op": "count", "as": "num_cars"}], "groupby": ["Origin", "Cylinders"]},
    {"joinaggregate": [{"op": "max", "field": "num_cars", "as": "max_num_cars"}]},
    {"calculate": "datum.num_cars > 0.5 * datum.max_num_cars", "as": "more_than_half"}
  ],
  "encoding": {
    "y": {"field": "Origin", "type": "ordinal"},
    "x": {"field": "Cylinders", "type": "ordinal"}
  },
  "layer": [
    {"mark": "rect", "encoding": {"color": {"field": "num_cars", "type": "quantitative"}}},
    {
      "mark": "text",
      "encoding": {
        "text": {"field": "num_cars", "type": "quantitative"},
        "color": {
          "field": "more_than_half",
          "type": "nominal",
          "scale": {"domain": [false, true], "range": ["black", "white"]},
          "legend": null
        }
      }
    }
  ]
}
