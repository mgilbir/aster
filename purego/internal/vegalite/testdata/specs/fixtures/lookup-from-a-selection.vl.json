{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A join against the rows a selection has picked, the selection opening with a stated instant already in its store.",
  "data": {"url": "data/stocks.csv", "format": {"parse": {"date": "date"}}},
  "width": 400,
  "height": 200,
  "layer": [
    {
      "params": [{
        "name": "index",
        "value": [{"x": {"year": 2005, "month": 1, "date": 1}}],
        "select": {"type": "point", "encodings": ["x"], "on": "pointerover", "nearest": true}
      }],
      "mark": "point",
      "encoding": {
        "x": {"field": "date", "type": "temporal", "axis": null},
        "opacity": {"value": 0}
      }
    },
    {
      "transform": [
        {"lookup": "symbol", "from": {"param": "index", "key": "symbol"}},
        {"calculate": "datum.index && datum.index.price > 0 ? (datum.price - datum.index.price)/datum.index.price : 0", "as": "indexed_price"}
      ],
      "mark": "line",
      "encoding": {
        "x": {"field": "date", "type": "temporal", "axis": null},
        "y": {"field": "indexed_price", "type": "quantitative", "axis": {"format": "%"}},
        "color": {"field": "symbol", "type": "nominal"}
      }
    }
  ]
}
