{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A selection driven from two range controls rather than from the pointer: one signal per projected field, and a tuple that is null until both hold something.",
  "data": {"url": "data/cars.json"},
  "params": [
    {
      "name": "CylYr",
      "select": {"type": "point", "fields": ["Cylinders", "Year"]},
      "bind": {
        "Cylinders": {"input": "range", "min": 3, "max": 8, "step": 1},
        "Year": {"input": "range", "min": 1969, "max": 1981, "step": 1}
      }
    }
  ],
  "mark": "circle",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "color": {
      "condition": {"param": "CylYr", "field": "Origin", "type": "nominal"},
      "value": "grey"
    },
    "size": {"condition": {"param": "CylYr", "value": 100, "empty": false}, "value": 50}
  }
}
