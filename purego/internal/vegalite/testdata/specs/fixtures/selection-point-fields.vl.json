{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A selection remembering rows by a column rather than by their identity, picked on hover.",
  "data": {"url": "data/cars.json"},
  "params": [
    {"name": "sel", "select": {"type": "point", "on": "pointerover", "fields": ["Origin"], "toggle": false}}
  ],
  "mark": "point",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "opacity": {"condition": {"param": "sel", "value": 1}, "value": 0.2}
  }
}
