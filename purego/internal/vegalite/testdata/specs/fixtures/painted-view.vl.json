{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A surface and a plotting area painted different colours, and a binned heatmap over them.",
  "background": "orange",
  "view": {
    "fill": "yellow",
    "stroke": "black"
  },
  "data": {
    "url": "data/movies.json"
  },
  "mark": "rect",
  "encoding": {
    "x": {
      "bin": {
        "maxbins": 10
      },
      "field": "IMDB Rating"
    },
    "y": {
      "bin": {
        "maxbins": 10
      },
      "field": "Rotten Tomatoes Rating"
    },
    "color": {
      "aggregate": "count"
    }
  }
}
