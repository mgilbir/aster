{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A table that is generated rather than loaded, which is a transform and not a table.",
  "width": 300,
  "height": 150,
  "data": {"sequence": {"start": 0, "stop": 12.7, "step": 0.1, "as": "x"}},
  "transform": [{"calculate": "sin(datum.x)", "as": "sin(x)"}],
  "mark": "line",
  "encoding": {
    "x": {"field": "x", "type": "quantitative"},
    "y": {"field": "sin(x)", "type": "quantitative"}
  }
}
