{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 300,
  "description": "A rect marking the gaps in a series, drawn over the missing point rather than after it.",
  "data": {
    "values": [
      {"a": "Jan 1, 2000", "b": 28},
      {"a": "Jan 2, 2000", "b": 55},
      {"a": "Jan 3, 2000", "b": null},
