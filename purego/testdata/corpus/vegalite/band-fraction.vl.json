{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A rect asking for a fraction of its bucket, drawn inside the bucket rather than across it.",
  "data": {"url": "data/stocks.csv"},
  "mark": {"type": "bar", "width": {"band": 0.7}},
  "encoding": {
    "x": {"timeUnit": "month", "field": "date"},
    "y": {"aggregate": "mean", "field": "price"}
  }
}
