{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A grid faceted both ways whose cells size themselves: the counting is done once per cell in a crossed dataset, and each band takes the greatest of its own.",
  "data": {"values": [
    {"r": "r1", "c": "c1", "a": "a1", "b": "b1"},
    {"r": "r1", "c": "c1", "a": "a2", "b": "b2"},
    {"r": "r2", "c": "c2", "a": "a1", "b": "b1"},
    {"r": "r3", "c": "c2", "a": "a3", "b": "b2"}
  ]},
  "facet": {"row": {"field": "r"}, "column": {"field": "c"}},
  "spec": {
    "mark": "rect",
    "encoding": {
      "y": {"field": "b", "type": "nominal"},
      "x": {"field": "a", "type": "nominal"}
    }
  },
  "resolve": {"scale": {"x": "independent", "y": "independent"}}
}
