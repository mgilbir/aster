{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Two measures",
  "description": "A composition's own title, and a title on each plot inside it.",
  "data": {"url": "data/cars.json"},
  "concat": [
    {
      "title": "Horsepower",
      "width": 100,
      "height": 100,
      "mark": "point",
      "encoding": {
        "x": {"field": "Horsepower", "type": "quantitative"},
        "y": {"field": "Miles_per_Gallon", "type": "quantitative"}
      }
    },
    {
      "title": "Weight",
      "width": 100,
      "height": 100,
      "mark": "point",
      "encoding": {
        "x": {"field": "Weight_in_lbs", "type": "quantitative"},
        "y": {"field": "Miles_per_Gallon", "type": "quantitative"}
      }
    }
  ]
}
