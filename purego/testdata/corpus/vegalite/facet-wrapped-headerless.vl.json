{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A wrapped facet whose header names nothing: the cells caption themselves in the header's own label size, and a title written as a list is one name in a sentence.",
  "data": {"url": "data/cars.json"},
  "width": 120,
  "height": 90,
  "mark": "point",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "color": {
      "field": "Acceleration",
      "type": "quantitative",
      "scale": {"scheme": "viridis"},
      "legend": {"format": ".0f"},
      "title": ["Acceleration", "0-60 mph"]
    },
    "facet": {"field": "Origin", "type": "nominal", "columns": 2, "header": {"title": null, "labelFontSize": 14}}
  }
}
