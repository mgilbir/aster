{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A voronoi overlay that carries the marks' own tooltip, since the pointer is over a cell rather than over a point.",
  "data": {"url": "data/cars.json"},
  "params": [{"name": "hover", "select": {"type": "point", "on": "pointerover", "nearest": true}}],
  "mark": "circle",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "tooltip": [
      {"field": "Horsepower", "type": "quantitative"},
      {"field": "Miles_per_Gallon", "type": "quantitative"}
    ],
    "opacity": {"condition": {"param": "hover", "value": 1, "empty": false}, "value": 0.3}
  }
}
