{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "One tree drawn twice: a squarified treemap sized by value, and an icicle plot beside it where every level gets an equal band.",
  "width": 250,
  "height": 120,
  "padding": 5,
  "data": [
    {
      "name": "tree",
      "values": [
        {"id": "all", "parent": null, "size": 0, "label": ""},
        {"id": "eu", "parent": "all", "size": 0, "label": "eu"},
        {"id": "as", "parent": "all", "size": 0, "label": "as"},
        {"id": "fr", "parent": "eu", "size": 12, "label": "fr"},
        {"id": "de", "parent": "eu", "size": 18, "label": "de"},
        {"id": "es", "parent": "eu", "size": 7, "label": "es"},
        {"id": "jp", "parent": "as", "size": 21, "label": "jp"},
        {"id": "kr", "parent": "as", "size": 9, "label": "kr"}
      ]
    },
    {
      "name": "boxes",
      "source": "tree",
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {
          "type": "treemap",
          "field": "size",
          "size": [120, 120],
          "paddingInner": 2,
          "paddingOuter": 1,
          "round": true
        },
        {"type": "filter", "expr": "datum.children === 0"}
      ]
    },
    {
      "name": "icicle",
      "source": "tree",
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {"type": "partition", "field": "size", "size": [110, 120], "padding": 1},
        {"type": "formula", "expr": "datum.x0 + 130", "as": "px0"},
        {"type": "formula", "expr": "datum.x1 + 130", "as": "px1"}
      ]
    }
  ],
  "scales": [
    {
      "name": "colour",
      "type": "ordinal",
      "domain": {"data": "tree", "field": "label"},
      "range": {"scheme": "tableau10"}
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "boxes"},
      "encode": {
        "enter": {
          "x": {"field": "x0"},
          "x2": {"field": "x1"},
          "y": {"field": "y0"},
          "y2": {"field": "y1"},
          "fill": {"scale": "colour", "field": "label"}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "boxes"},
      "encode": {
        "enter": {
          "x": {"signal": "(datum.x0 + datum.x1) / 2"},
          "y": {"signal": "(datum.y0 + datum.y1) / 2"},
          "text": {"field": "label"},
          "align": {"value": "center"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 10},
          "fill": {"value": "#ffffff"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "icicle"},
      "encode": {
        "enter": {
          "x": {"field": "px0"},
          "x2": {"field": "px1"},
          "y": {"field": "y0"},
          "y2": {"field": "y1"},
          "fill": {"scale": "colour", "field": "label"},
          "stroke": {"value": "#ffffff"},
          "strokeWidth": {"value": 1}
        }
      }
    }
  ]
}
