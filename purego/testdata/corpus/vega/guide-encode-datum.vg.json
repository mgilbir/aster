{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "width": 240,
  "height": 120,
  "padding": 5,
  "data": [
    {
      "name": "t",
      "values": [
        {
          "c": "a",
          "v": 2
        },
        {
          "c": "b",
          "v": 6
        },
        {
          "c": "c",
          "v": 4
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {
        "data": "t",
        "field": "c"
      },
      "range": "width",
      "padding": 0.2
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [
        0,
        8
      ],
      "range": "height",
      "nice": false
    }
  ],
  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "tickCount": 4,
      "grid": true,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "field": "label"
            },
            "fill": [
              {
                "test": "datum.value >= 4",
                "value": "#d62728"
              },
              {
                "value": "#333333"
              }
            ],
            "fontWeight": [
              {
                "test": "datum.value === 8",
                "value": "bold"
              },
              {
                "value": "normal"
              }
            ],
            "fontSize": [
              {
                "test": "datum.value === 0",
                "value": 14
              },
              {
                "value": 10
              }
            ],
            "angle": [
              {
                "test": "datum.value === 6",
                "value": -45
              },
              {
                "value": 0
              }
            ],
            "align": [
              {
                "test": "datum.value === 2",
                "value": "left"
              },
              {
                "value": "right"
              }
            ],
            "baseline": [
              {
                "test": "datum.value === 8",
                "value": "top"
              },
              {
                "value": "middle"
              }
            ]
          }
        },
        "grid": {
          "update": {
            "stroke": [
              {
                "test": "datum.value === 4",
                "value": "#000000"
              },
              {
                "value": "#dddddd"
              }
            ],
            "strokeWidth": [
              {
                "test": "datum.value === 4",
                "value": 2
              },
              {
                "value": 1
              }
            ],
            "strokeDash": [
              {
                "test": "datum.value === 2",
                "value": [
                  4,
                  2
                ]
              },
              {
                "value": []
              }
            ],
            "strokeOpacity": [
              {
                "test": "datum.value === 6",
                "value": 0.3
              },
              {
                "value": 1
              }
            ],
            "strokeDashOffset": [
              {
                "test": "datum.value === 2",
                "value": 2
              },
              {
                "value": 0
              }
            ]
          }
        },
        "ticks": {
          "update": {
            "strokeWidth": [
              {
                "test": "datum.value >= 4",
                "value": 3
              },
              {
                "value": 1
              }
            ],
            "stroke": [
              {
                "test": "datum.value >= 6",
                "value": "#1f77b4"
              },
              {
                "value": "#888888"
              }
            ],
            "strokeCap": [
              {
                "test": "datum.value === 8",
                "value": "round"
              },
              {
                "value": "butt"
              }
            ]
          }
        },
        "domain": {
          "update": {
            "strokeWidth": {
              "field": "value"
            }
          }
        }
      }
    },
    {
      "scale": "x",
      "orient": "bottom",
      "encode": {
        "labels": {
          "update": {
            "text": {
              "field": "label"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "t"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "field": "c"
          },
          "width": {
            "scale": "x",
            "band": 1
          },
          "y": {
            "scale": "y",
            "field": "v"
          },
          "y2": {
            "scale": "y",
            "value": 0
          },
          "fill": {
            "value": "#4c78a8"
          }
        }
      }
    }
  ]
}
