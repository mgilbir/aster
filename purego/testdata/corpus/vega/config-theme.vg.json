{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "A theme in `config`: guide styles at the bottom of the chain, then axis, then axisX, then axisBottom, then axisBand, with one axis overriding the lot from its own properties. Two of those properties are here for where they are *not* read. `tickOffset` is a plain axis property and not a band one, so the linear axis takes the theme's 6 and moves its ticks and its labels by it — while both band axes keep the -0.5 that Vega's own default `config.axisBand` carries, because that block is merged last and beats `config.axis`. And `position` is the one axis property upstream reads from the specification alone: `value(spec.position, 0)` where every other entry in the same block goes through `lookup(spec, config)`. So the theme's 10 moves nothing at all, and the 7 the top axis asks for itself moves that axis.",
  "width": 200,
  "height": 120,
  "padding": 5,
  "config": {
    "style": {
      "guide-label": {"fill": "#556677", "fontSize": 9},
      "guide-title": {"fill": "#223344", "fontSize": 13, "fontWeight": "normal"}
    },
    "axis": {
      "tickSize": 3,
      "tickColor": "#aa4444",
      "domainColor": "#aa4444",
      "labelPadding": 4,
      "gridColor": "#dddddd",
      "tickOffset": 6,
      "position": 10
    },
    "axisX": {"tickSize": 6, "tickColor": "#4444aa"},
    "axisBottom": {"tickSize": 9, "labelPadding": 6},
    "axisBand": {"tickSize": 12, "domainColor": "#44aa44"},
    "legend": {
      "labelColor": "#775566",
      "titleColor": "#332211",
      "symbolStrokeColor": "#999999",
      "labelFontSize": 11
    }
  },
  "data": [
    {
      "name": "table",
      "values": [
        {"c": "alpha", "v": 42},
        {"c": "bravo", "v": 88},
        {"c": "charlie", "v": 17}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "band",
      "domain": {"data": "table", "field": "c"},
      "range": "width",
      "padding": 0.2
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {"data": "table", "field": "v"},
      "range": "height",
      "nice": true
    },
    {
      "name": "colour",
      "type": "ordinal",
      "domain": {"data": "table", "field": "c"},
      "range": {"scheme": "tableau10"}
    }
  ],
  "axes": [
    {"orient": "bottom", "scale": "x", "title": "Band, themed all the way down"},
    {"orient": "top", "scale": "x", "tickSize": 2, "tickColor": "#000000", "position": 7},
    {"orient": "left", "scale": "y", "tickCount": 4, "grid": true, "title": "Linear"}
  ],
  "legends": [{"fill": "colour", "title": "Series"}],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "c"},
          "width": {"scale": "x", "band": 1},
          "y": {"scale": "y", "field": "v"},
          "y2": {"scale": "y", "value": 0},
          "fill": {"scale": "colour", "field": "c"}
        }
      }
    }
  ]
}
