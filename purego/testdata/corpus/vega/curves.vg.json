{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The four spline families over one series — monotone, natural, basis and cardinal — with a monotone area beneath, so the one that never overshoots can be told from the three that do.",
  "width": 260,
  "height": 150,
  "padding": 5,
  "data": [
    {
      "name": "table",
      "values": [
        {"x": 0, "y": 20},
        {"x": 1, "y": 62},
        {"x": 2, "y": 58},
        {"x": 3, "y": 12},
        {"x": 4, "y": 40},
        {"x": 5, "y": 44}
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {"data": "table", "field": "x"},
      "range": "width",
      "zero": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": [0, 70],
      "range": "height"
    }
  ],
  "axes": [
    {"orient": "bottom", "scale": "x", "tickCount": 6},
    {"orient": "left", "scale": "y", "tickCount": 4}
  ],
  "marks": [
    {
      "type": "area",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "y2": {"scale": "y", "value": 0},
          "interpolate": {"value": "monotone"},
          "fill": {"value": "#dbe9f6"}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "interpolate": {"value": "monotone"},
          "stroke": {"value": "#4c78a8"},
          "strokeWidth": {"value": 2}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "interpolate": {"value": "natural"},
          "stroke": {"value": "#f58518"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "interpolate": {"value": "basis"},
          "stroke": {"value": "#54a24b"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "line",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "x"},
          "y": {"scale": "y", "field": "y"},
          "interpolate": {"value": "cardinal"},
          "stroke": {"value": "#e45756"},
          "strokeWidth": {"value": 1}
        }
      }
    }
  ]
}
