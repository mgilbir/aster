{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "an axis whose maxExtent is below its minExtent, which is a pair of numbers a specification is free to write: upstream clamps with max(minExtent, min(maxExtent, extent)), so the minimum wins and the axis is drawn.",
  "width": 200,
  "height": 120,
  "padding": 5,
  "data": [
    {
      "name": "t",
      "values": [
        {"c": "alpha", "v": 28},
        {"c": "beta", "v": 55},
        {"c": "gamma", "v": 43}
      ]
    }
  ],
  "scales": [
    {"name": "x", "type": "band", "domain": {"data": "t", "field": "c"}, "range": "width", "padding": 0.1},
    {"name": "y", "type": "linear", "domain": {"data": "t", "field": "v"}, "range": "height", "nice": true}
  ],
  "axes": [
    {"orient": "bottom", "scale": "x", "title": "category", "minExtent": 40, "maxExtent": 4},
    {"orient": "left", "scale": "y", "title": "amount", "tickCount": 4, "minExtent": 0, "maxExtent": -4}
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "t"},
      "encode": {
        "enter": {
          "x": {"scale": "x", "field": "c"},
          "width": {"scale": "x", "band": 1},
          "y": {"scale": "y", "field": "v"},
          "y2": {"scale": "y", "value": 0},
          "fill": {"value": "steelblue"}
        }
      }
    }
  ]
}
