      "value": "#f4f4f4"
     }
    }
   },
   "signals": [
    {
     "name": "inner",
     "update": "outer * 2 + length(data('series'))"
    }
   ],
   "scales": [
    {
     "name": "y",
     "type": "linear",
     "domain": {
      "data": "series",
      "field": "v"
     },
     "range": "height",
     "zero": true
    }
   ],
   "axes": [
    {
     "orient": "left",
     "scale": "y",
     "tickCount": 3
    }
   ],
   "marks": [
    {
     "type": "symbol",
     "from": {
      "data": "series"
     },
     "encode": {
