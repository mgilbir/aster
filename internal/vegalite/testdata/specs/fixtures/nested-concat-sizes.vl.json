{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A row of columns, which shares a height with neither of them.",
  "data": {"url": "data/cars.json"},
  "hconcat": [
    {
      "vconcat": [
        {"width": 100, "height": 100, "mark": "point", "encoding": {"x": {"field": "Horsepower", "type": "quantitative"}, "y": {"field": "Miles_per_Gallon", "type": "quantitative"}}},
        {"width": 100, "height": 100, "mark": "point", "encoding": {"x": {"field": "Weight_in_lbs", "type": "quantitative"}, "y": {"field": "Miles_per_Gallon", "type": "quantitative"}}}
      ]
    },
    {
      "vconcat": [
        {"width": 100, "height": 100, "mark": "point", "encoding": {"x": {"field": "Acceleration", "type": "quantitative"}, "y": {"field": "Miles_per_Gallon", "type": "quantitative"}}},
        {"width": 100, "height": 100, "mark": "point", "encoding": {"x": {"field": "Displacement", "type": "quantitative"}, "y": {"field": "Miles_per_Gallon", "type": "quantitative"}}}
      ]
    }
  ]
}
