{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A scatter a reader drags a rectangle across, which is an interval selection compiled into a brush: two rects around the marks, and the signals that pan, zoom and clear it.",
  "data": {"url": "data/cars.json"},
  "params": [{"name": "brush", "select": "interval"}],
  "mark": "point",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "color": {
      "condition": {"param": "brush", "field": "Cylinders", "type": "ordinal"},
      "value": "grey"
    }
  }
}
