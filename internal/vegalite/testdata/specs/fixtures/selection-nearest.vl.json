{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "A scatter that highlights the point nearest the pointer, which compiles to a voronoi overlay the selection listens on rather than to the marks themselves.",
  "data": {"url": "data/cars.json"},
  "params": [{"name": "paintbrush", "select": {"type": "point", "on": "pointerover", "nearest": true}}],
  "mark": "circle",
  "encoding": {
    "x": {"field": "Horsepower", "type": "quantitative"},
    "y": {"field": "Miles_per_Gallon", "type": "quantitative"},
    "size": {"condition": {"param": "paintbrush", "value": 300, "empty": false}, "value": 50}
  }
}
