# Sites in internal/vegalite where a value's text (Value.AsString) is compared, and why
# upstream reads the text there. See TestKeywordsAreNotComparedAsText.
# file.go:func count  # why
axis.go:assembleAxisSignals 1  # update is getSizeSignalRef(...).signal, a signal name the compiler made (a string); upstream compares it with sizeType
channeldef.go:vgField 1  # fn is String(aggregate), binToString's or timeUnitToString's text: upstream tests it for truth (`if (fn)`), "" being the falsy string
datanodes2.go:makeAggregateFromEncoding 1  # the aggregate op as a property key (meas[field][op]): "__proto__" names the prototype there, not a measure
datanodes2.go:makeAggregateFromTransform 1  # likewise, the op of an aggregate transform as meas[field][op]'s key
markpos.go:positionAndSize 2  # vgChannel is read from ALIGNED_X/Y_CHANNEL with the alignment as a key: one of the table's names or undefined (""), compared with 'xc'/'yc' as upstream does
vl5.go:positionAndSize58 2  # likewise, in 5.8's positionAndSize
projection.go:assembleProjectionForModel 1  # the fit sources are signal expressions and data('...') texts the compiler made, compared by contains
selection.go:nearestCompiler 1  # mark names the compiler made (strings)
